CONFIG_CK_TOOLS_PATH="../../../"
CONFIG_PRO_TOP_PATH="../.."

#
# toolchain config
#
# CONFIG_TC_SYSTEM_NAME_GENERIC is not set
CONFIG_TC_SYSTEM_NAME_WINDOWS=y
# CONFIG_TC_SYSTEM_NAME_LINUX is not set
# CONFIG_TC_SYSTEM_NAME_DARWIN is not set
CONFIG_TC_CPU_X86_64=y
# CONFIG_TC_CPU_ARM is not set
# CONFIG_TC_CPU_AARCH64 is not set
# CONFIG_TC_CPU_MIPS is not set
# CONFIG_TC_CPU_RISCV64 is not set
CONFIG_TC_BUILD_TYPE_DEBUG=y
# CONFIG_TC_BUILD_TYPE_RELEASE is not set
# CONFIG_TC_BUILD_TYPE_RELWITHDEBINFO is not set
# CONFIG_TC_BUILD_TYPE_MINSIZEREL is not set
# CONFIG_TC_CROSSCOMPILING is not set
CONFIG_TC_C_STANDARD="11"
CONFIG_TC_CXX_STANDARD="11"
CONFIG_TC_C_CXX_COMPILER="/usr/bin/gcc"
CONFIG_TC_DEFINE_MACROS=""
CONFIG_TC_COMPILE_OPTIONS="-lm -g -O0"
CONFIG_TC_LINK_OPTIONS=""
CONFIG_TC_LIBRARY_DIRS="./"
CONFIG_TC_LINK_LIBRARIES=""
CONFIG_TC_LINK_FILE=""
# CONFIG_TC_GENERATE_BIN is not set
# CONFIG_TC_GENERATE_DISASSEMBLY is not set
# CONFIG_TC_GENERATE_MAP_FILE is not set
# end of toolchain config

#
# project config
#
CONFIG_PRO_NAME="template"
CONFIG_PRO_TEST_UNIT=y
# CONFIG_PRO_TEST_INTEGRATION is not set
# CONFIG_PRO_TEST_NONE is not set
# end of project config

#
# driver config
#
CONFIG_DRV_DRV1=y
CONFIG_DRV_DRV1_NUM=0
# end of driver config

#
# package config
#
CONFIG_PACK_PACK1=y
CONFIG_PACK_PACK1_STR="it's pack1"
CONFIG_PACK_UNITY_ENABLE=y
CONFIG_PACK_UNITY_EX_FIXTURE=y
CONFIG_PACK_UNITY_EX_MEMORY=y
# end of package config
