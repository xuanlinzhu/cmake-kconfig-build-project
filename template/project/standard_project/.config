CONFIG_CK_TOOLS_ROOT="../../.."
CONFIG_CK_WORKSPACE_ROOT="../.."
CONFIG_CK_PROJECT_TYPE="STANDARD"
CONFIG_CK_CMD_CONFIGURE="cmake -S . -B build -G Ninja"
CONFIG_CK_CMD_BUILD="cmake --build build -j4"
CONFIG_CK_CMD_CLEAN="cmake --build build --target clean"

#
# toolchain config
#
# CONFIG_TC_SYSTEM_NAME_GENERIC is not set
CONFIG_TC_SYSTEM_NAME_WINDOWS=y
# CONFIG_TC_SYSTEM_NAME_LINUX is not set
# CONFIG_TC_SYSTEM_NAME_DARWIN is not set
CONFIG_TC_CPU_X86_64=y
# CONFIG_TC_CPU_ARM is not set
# CONFIG_TC_CPU_AARCH64 is not set
# CONFIG_TC_CPU_MIPS is not set
# CONFIG_TC_CPU_RISCV64 is not set
CONFIG_TC_BUILD_TYPE_DEBUG=y
# CONFIG_TC_BUILD_TYPE_RELEASE is not set
# CONFIG_TC_BUILD_TYPE_RELWITHDEBINFO is not set
# CONFIG_TC_BUILD_TYPE_MINSIZEREL is not set
# CONFIG_TC_CROSSCOMPILING is not set
CONFIG_TC_C_STANDARD="11"
CONFIG_TC_CXX_STANDARD="11"
CONFIG_TC_C_CXX_COMPILER=""
CONFIG_TC_DEFINE_MACROS="MY_KEY=1 MY_STR=123"
CONFIG_TC_COMPILE_OPTIONS="-O0 -DEBUG"
CONFIG_TC_LINK_OPTIONS="-O0 -DEBUG"
CONFIG_TC_LIBRARY_DIRS="./"
CONFIG_TC_LINK_LIBRARIES="m libopen62541.a"
CONFIG_TC_LINK_FILE=""
CONFIG_TC_GENERATE_BIN=y
CONFIG_TC_GENERATE_DISASSEMBLY=y
CONFIG_TC_GENERATE_MAP_FILE=y
# end of toolchain config

#
# project config
#
CONFIG_PRO_NAME="ck_project"
CONFIG_CK_VERSION_ENABLE=y
# CONFIG_CK_TEST_UNIT is not set
# end of project config

#
# package config
#
CONFIG_DRV_DRV1=y
CONFIG_DRV_DRV1_NUM=0
# CONFIG_PACK_PACK1 is not set
# CONFIG_PACK_UNITY_ENABLE is not set
# CONFIG_SUM_MOD is not set
# end of package config
