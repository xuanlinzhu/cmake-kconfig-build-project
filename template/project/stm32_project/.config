CONFIG_CK_TOOLS_ROOT="../../.."
CONFIG_CK_WORKSPACE_ROOT="../.."
CONFIG_CK_CMD_CONFIGURE="cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_TOOLCHAIN_FILE=cmake/gcc-arm-none-eabi.cmake"
CONFIG_CK_CMD_BUILD="cmake --build build -j4"
CONFIG_CK_CMD_CLEAN="cmake --build build --target clean"

#
# project config
#
CONFIG_PRO_NAME="ck_project"
# CONFIG_CK_VERSION_ENABLE is not set
# end of project config

#
# package config
#
CONFIG_DRV_DRV1=y
CONFIG_DRV_DRV1_NUM=0
CONFIG_PACK_PACK1=y
CONFIG_PACK_PACK1_STR="it's pack1"
# CONFIG_PACK_UNITY_ENABLE is not set
CONFIG_SUM_MOD=y
# end of package config
